PORT=4000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nexworth

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE=7d
# Reserved for a future refresh-token increment — not used yet.
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRE=30d
COOKIE_NAME=nxw_session

# Cloudinary (ID documents + photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack
PAYSTACK_SECRET_KEY=

# CORS
CLIENT_URL=http://localhost:3000
